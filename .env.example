# Copy to .env and change the key. The service refuses to start without API_KEY.
API_KEY=change-me

# ML server on the GPU machine (POST {ML_URL}/infer). Without ML_URL the local stub pipeline runs.
# Same machine: http://localhost:8001. Tunnel: https://<name>.trycloudflare.com (changes on restart).
ML_URL=
ML_TOKEN=

# Optional: path to an alternative config file (default: ./config.yaml)
# CONFIG_PATH=./config.yaml
